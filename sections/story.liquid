<section class="section founder-section">
  <div class="founder-photo">
    <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="Ariel G. Harris, founder of A Gabrielle" loading="lazy">
  </div>
  <div class="founder-story">
    <p class="eyebrow">Our story</p>
    <h2>{{ section.settings.heading }}</h2>
    <blockquote>
      <p>{{ section.settings.quote }}</p>
      <span class="signature">— {{ section.settings.signature }}</span>
    </blockquote>
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Founder image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A ritual rooted in care." },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "I created A Gabrielle to make everyday self-care feel luxurious, grounding, and personal—something you can look forward to, not just endure." },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Ariel G. Harris" }
  ]
}
{% endschema %}
